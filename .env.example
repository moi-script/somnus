# Copy to .env and fill in. .env is gitignored.

# --- API ---------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/lacs
API_PORT=4000

# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-before-running-anything-real
JWT_EXPIRES_IN=7d

# Comma-separated origins allowed to call the API.
# The Capacitor webview sends Origin: http://localhost, so keep that entry
# or the Android app's requests get blocked by CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost,capacitor://localhost

# --- Web ---------------------------------------------------------------
# Baked into the bundle at build time. For an APK this must be the LAN IP or
# public URL of the API, never localhost - localhost on a phone is the phone.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- serial-bridge -----------------------------------------------------
# Find the port with:  arduino-cli board list
SERIAL_PORT=COM5
SERIAL_BAUD=115200
BRIDGE_API_URL=http://localhost:4000
# Ingest token printed when you claim the device in the dashboard.
BRIDGE_DEVICE_TOKEN=
